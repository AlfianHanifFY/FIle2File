{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "swift build",
            "type": "shell",
            "command": "swift build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$swift"
        },
        {
            "label": "swift run",
            "type": "shell",
            "command": "swift run",
            "group": "test",
            "problemMatcher": "$swift"
        }
    ]
}
